@model luyentap.Models.NhbMember

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>NhbMember</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" asp-route-id="@Model.NhbMemberId">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NhbMemberId" />
            <div class="form-group">
                <label asp-for="NhbMemberUserName" class="control-label"></label>
                <input asp-for="NhbMemberUserName" class="form-control" />
                <span asp-validation-for="NhbMemberUserName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NhbMemberPassword" class="control-label"></label>
                <input asp-for="NhbMemberPassword" class="form-control" />
                <span asp-validation-for="NhbMemberPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NhbMemberEmail" class="control-label"></label>
                <input asp-for="NhbMemberEmail" class="form-control" />
                <span asp-validation-for="NhbMemberEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NhbMemberFullName" class="control-label"></label>
                <input asp-for="NhbMemberFullName" class="form-control" />
                <span asp-validation-for="NhbMemberFullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
